{
  "name": "nine-heavens",
  "productName": "Nine Heavens",
  "version": "0.1.0",
  "description": "Nine Heavens — a xianxia roguelike auto-battler",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "elie55",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "electron:build": "npm run build && electron-builder --win --config electron-builder.json",
    "sim": "tsx scripts/sim.ts",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "gsap": "^3.15.1",
    "howler": "^2.2.4",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.22.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/howler": "^2.2.12",
    "@types/node": "^24.0.0",
    "cross-env": "^10.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
